---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = await getCollection('posts');
const sorted = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const grouped = new Map<number, typeof sorted>();
for (const post of sorted) {
  const year = new Date(post.data.date).getFullYear();
  if (!grouped.has(year)) grouped.set(year, []);
  grouped.get(year)!.push(post);
}

---

<BaseLayout title="Search" description="Search and browse all articles">
  <section class="reveal">
    <header class="mb-10">
      <p class="label-caps text-vermilion mb-4">§ The Archive</p>
      <h1 class="font-display font-semibold text-ink tracking-tight text-4xl md:text-5xl leading-[1.05] mb-3">
        Search
      </h1>
      <p class="font-newsreader text-lg text-ink-3 italic">Filter the journal by title, tag, or keyword.</p>
    </header>

    <!-- Search -->
    <div class="relative mb-12">
      <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-ink-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input
        type="text"
        id="archive-search"
        placeholder="Search the journal…"
        class="w-full bg-paper-2/60 border border-rule hover:border-rule-2 rounded-none pl-11 pr-4 py-3 font-newsreader text-base text-ink placeholder-ink-4 italic
               focus:outline-none focus:border-vermilion focus:bg-paper-2 transition-colors"
        autocomplete="off"
      />
      <span class="absolute right-4 top-1/2 -translate-y-1/2 label-caps text-ink-4 pointer-events-none hidden sm:block" id="result-count"></span>
    </div>

    <!-- Archive list -->
    <div id="archive-list" class="space-y-12">
      {[...grouped.entries()].map(([year, yearPosts]) => (
        <div data-year={year}>
          <div class="flex items-baseline gap-4 mb-5">
            <h2 class="font-display font-semibold text-ink text-3xl tracking-tight">{year}</h2>
            <span class="h-px flex-1 bg-rule"></span>
            <span class="label-caps text-ink-4">{yearPosts.length} {yearPosts.length === 1 ? 'entry' : 'entries'}</span>
          </div>
          <div class="space-y-4">
            {yearPosts.map((post) => {
              const { title, description } = post.data;
              const d = new Date(post.data.date);
              const monthDay = d.toLocaleDateString('zh-CN', { month: 'long', day: 'numeric' });

              return (
                <article class="group flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-6 border-b border-rule/60 pb-4" data-slug={post.slug}>
                  <time class="font-mono text-xs text-ink-4 shrink-0 sm:w-28">{monthDay}</time>
                  <div class="min-w-0">
                    <a
                      href={`/posts/${post.slug}`}
                      class="font-display font-semibold text-ink text-lg leading-snug no-underline transition-colors group-hover:text-vermilion"
                    >
                      {title}
                    </a>
                    <p class="font-newsreader text-sm text-ink-3 mt-1 leading-relaxed">{description}</p>
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  let posts: Array<{ title: string; slug: string; tags: string[]; description: string }> = [];

  async function loadPosts() {
    try {
      const res = await fetch('/search.json');
      if (res.ok) posts = await res.json();
    } catch (_) {}
  }

  const input = document.getElementById('archive-search') as HTMLInputElement;
  const list = document.getElementById('archive-list')!;
  const count = document.getElementById('result-count')!;

  input.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    const articles = list.querySelectorAll<HTMLElement>('article[data-slug]');
    const yearGroups = list.querySelectorAll<HTMLElement>('[data-year]');

    if (!q) {
      articles.forEach((a) => (a.style.display = ''));
      yearGroups.forEach((g) => (g.style.display = ''));
      count.textContent = '';
      return;
    }

    const matchSet = new Set(
      posts
        .filter(
          (p) =>
            p.title.toLowerCase().includes(q) ||
            p.tags.some((t) => t.toLowerCase().includes(q)) ||
            p.description.toLowerCase().includes(q),
        )
        .map((p) => p.slug),
    );

    let visibleCount = 0;
    articles.forEach((a) => {
      const visible = matchSet.has(a.dataset.slug!);
      a.style.display = visible ? '' : 'none';
      if (visible) visibleCount++;
    });

    yearGroups.forEach((g) => {
      const visible = g.querySelectorAll<HTMLElement>('article[data-slug]');
      const hasVisible = Array.from(visible).some((a) => a.style.display !== 'none');
      g.style.display = hasVisible ? '' : 'none';
    });

    count.textContent = `${visibleCount} found`;
  });

  loadPosts();
</script>
