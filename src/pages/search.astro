---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Pagination from '../components/Pagination.astro';
import { POSTS_PER_PAGE } from '../lib/pagination';

const posts = await getCollection('posts');
const sorted = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const initialPosts = sorted.slice(0, POSTS_PER_PAGE);
const yearCounts = new Map<number, number>();
for (const post of sorted) {
  const year = post.data.date.getUTCFullYear();
  yearCounts.set(year, (yearCounts.get(year) ?? 0) + 1);
}

const grouped = new Map<number, typeof sorted>();
for (const post of initialPosts) {
  const year = post.data.date.getUTCFullYear();
  if (!grouped.has(year)) grouped.set(year, []);
  grouped.get(year)!.push(post);
}
// Keep one inert card as the client template, including a tag link to clone.
const templatePost = sorted[0] && { ...sorted[0], data: { ...sorted[0].data, tags: [''] } };
---

<BaseLayout title="搜索" description="搜索和浏览全部文章" wide="listing">
  <section>
    <header class="reveal mb-10">
      <h1 class="font-display font-semibold text-ink tracking-tight text-4xl md:text-5xl leading-[1.05] mb-3">
        搜索
      </h1>
      <p class="font-newsreader text-lg text-ink-3 italic">按标题、标签或关键词筛选文章。</p>
    </header>

    <!-- Search -->
    <div class="relative mb-12">
      <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-ink-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input
        type="text"
        id="archive-search"
        aria-label="搜索文章"
        aria-controls="archive-list"
        placeholder="搜索文章……"
        class="w-full bg-paper-2/60 border border-rule hover:border-rule-2 rounded-none pl-11 pr-4 sm:pr-40 py-3 text-base text-ink placeholder-ink-4
               focus:outline-none focus:border-vermilion focus:bg-paper-2 transition-colors"
        autocomplete="off"
        disabled
        aria-busy="true"
      />
      <span class="sr-only sm:not-sr-only sm:absolute sm:right-4 sm:top-1/2 sm:-translate-y-1/2 label-caps text-ink-4 pointer-events-none" id="result-count" role="status" aria-live="polite"></span>
    </div>

    <noscript>
      <p class="font-newsreader text-ink-3 mb-8">搜索需要 JavaScript。浏览更多文章请前往 <a href="/">文章列表</a> 或 <a href="/tags/">标签归档</a>。</p>
    </noscript>
    <p id="search-load-error" class="font-newsreader text-ink-3 mb-8" role="status" hidden>搜索暂时无法加载，请刷新重试，或前往 <a href="/">文章列表</a>、<a href="/tags/">标签归档</a> 继续浏览。</p>

    <!-- Archive list -->
    <div id="archive-list" class="space-y-12 scroll-mt-24">
      {[...grouped.entries()].map(([year, yearPosts]) => (
        <div data-year={year}>
          <div class="flex items-baseline gap-4 mb-5">
            <h2 class="font-display font-semibold text-ink text-3xl tracking-tight">{year}</h2>
            <span class="h-px flex-1 bg-rule"></span>
            <span class="label-caps text-ink-4" data-year-count>{yearCounts.get(year)} 篇文章</span>
          </div>
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-x-12 xl:gap-x-20 gap-y-10 lg:gap-y-12">
            {yearPosts.map((post) => (
              <PostCard {post} number={initialPosts.indexOf(post) + 1} animationDelay={initialPosts.indexOf(post) * 90} searchable />
            ))}
          </div>
        </div>
      ))}
    </div>
    {templatePost && (
      <template id="search-card-template">
        <PostCard post={templatePost} number={1} animationDelay={0} searchable />
      </template>
    )}
    <p id="search-empty" class="font-newsreader text-ink-3 italic" role="status" hidden>没有找到匹配的文章。</p>
    <Pagination id="search-pagination" current={1} total={Math.ceil(sorted.length / POSTS_PER_PAGE)} base="search/" client />
  </section>
</BaseLayout>

<style>
  #archive-search {
    /* Use the Chinese font's metrics to keep text centered beside the icon. */
    font-family: "Noto Serif SC", "Newsreader Variable", Georgia, serif;
  }
</style>

<script>
  import '../scripts/archive-search';
</script>
