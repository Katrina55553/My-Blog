---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ViewCounter from '../components/ViewCounter.astro';
import Pagination from '../components/Pagination.astro';
import { POSTS_PER_PAGE } from '../lib/pagination';

const posts = await getCollection('posts');
const sorted = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const grouped = new Map<number, typeof sorted>();
for (const post of sorted) {
  const year = post.data.date.getUTCFullYear();
  if (!grouped.has(year)) grouped.set(year, []);
  grouped.get(year)!.push(post);
}

const pad = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout title="搜索" description="搜索和浏览全部文章" wide="listing">
  <section>
    <header class="reveal mb-10">
      <h1 class="font-display font-semibold text-ink tracking-tight text-4xl md:text-5xl leading-[1.05] mb-3">
        搜索
      </h1>
      <p class="font-newsreader text-lg text-ink-3 italic">按标题、标签或关键词筛选文章。</p>
    </header>

    <!-- Search -->
    <div class="relative mb-12">
      <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-ink-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input
        type="text"
        id="archive-search"
        placeholder="搜索文章……"
        class="w-full bg-paper-2/60 border border-rule hover:border-rule-2 rounded-none pl-11 pr-4 sm:pr-40 py-3 font-newsreader text-base text-ink placeholder-ink-4 italic
               focus:outline-none focus:border-vermilion focus:bg-paper-2 transition-colors"
        autocomplete="off"
        disabled
        aria-busy="true"
      />
      <span class="absolute right-4 top-1/2 -translate-y-1/2 label-caps text-ink-4 pointer-events-none hidden sm:block" id="result-count"></span>
    </div>

    <!-- Archive list -->
    <div id="archive-list" class="space-y-12 scroll-mt-24">
      {[...grouped.entries()].map(([year, yearPosts]) => (
        <div data-year={year}>
          <div class="flex items-baseline gap-4 mb-5">
            <h2 class="font-display font-semibold text-ink text-3xl tracking-tight">{year}</h2>
            <span class="h-px flex-1 bg-rule"></span>
            <span class="label-caps text-ink-4" data-year-count>{yearPosts.length} 篇文章</span>
          </div>
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-x-12 xl:gap-x-20 gap-y-10 lg:gap-y-12">
            {yearPosts.map((post, i) => {
              const { title, date, tags, description } = post.data;
              const formattedDate = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

              return (
                <article class="card-rule group reveal min-w-0 lg:border-b border-rule lg:pb-8" style={`animation-delay: ${Math.min(i, 5) * 90}ms`} data-slug={post.slug} data-search={JSON.stringify([title, ...tags, description])}>
                  <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2 mb-2">
                    <span class="font-display text-vermilion font-semibold text-sm w-7 shrink-0 tabular-nums" data-entry-number>{pad(i + 1)}</span>
                    <time class="label-caps text-ink-4" datetime={date.toISOString().slice(0, 10)} lang="en">{formattedDate}</time>
                    <span class="text-rule-2">·</span>
                    <ViewCounter slug={post.slug} />
                  </div>
                  <h3 class="font-display font-semibold text-ink text-2xl md:text-3xl tracking-tight mb-2 pl-11">
                    <a
                      href={`/posts/${post.slug}/`}
                      class="no-underline bg-gradient-to-r from-vermilion to-vermilion bg-[length:0%_2px] bg-no-repeat bg-left-bottom transition-[background-size] duration-500 group-hover:bg-[length:100%_2px]"
                    >
                      {title}
                    </a>
                  </h3>
                  <p class="font-newsreader text-ink-2 leading-relaxed pl-11 mb-3">{description}</p>
                  <div class="flex flex-wrap gap-x-4 gap-y-1 pl-11">
                    {tags.map((tag: string) => (
                      <a href={`/tags/${tag}/`} class="font-mono text-xs text-ink-3 hover:text-vermilion transition-colors no-underline">
                        <span class="text-vermilion">#</span>{tag}
                      </a>
                    ))}
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      ))}
    </div>
    <p id="search-empty" class="font-newsreader text-ink-3 italic" role="status" hidden>没有找到匹配的文章。</p>
    <Pagination id="search-pagination" current={1} total={Math.ceil(sorted.length / POSTS_PER_PAGE)} base="search/" client />
  </section>
</BaseLayout>

<script>
  import { POSTS_PER_PAGE } from '../lib/pagination';

  const input = document.getElementById('archive-search') as HTMLInputElement;
  const list = document.getElementById('archive-list')!;
  const count = document.getElementById('result-count')!;
  const empty = document.getElementById('search-empty')!;
  const pagination = document.getElementById('search-pagination')!;
  const articles = Array.from(list.querySelectorAll<HTMLElement>('article[data-slug]'));
  const yearGroups = Array.from(list.querySelectorAll<HTMLElement>('[data-year]'));
  const posts = articles.map((article) => ({
    article,
    fields: (JSON.parse(article.dataset.search!) as string[]).map((field) => field.toLowerCase()),
    year: article.closest<HTMLElement>('[data-year]')!.dataset.year!,
  }));
  let currentPage = 1;

  function readLocation() {
    const params = new URLSearchParams(window.location.search);
    input.value = params.get('q') || '';
    const page = Number(params.get('page') || '1');
    currentPage = Number.isSafeInteger(page) && page > 0 ? page : 1;
  }

  function updateLocation(mode: 'push' | 'replace') {
    const url = new URL(window.location.href);
    const query = input.value.trim();
    if (query) url.searchParams.set('q', query);
    else url.searchParams.delete('q');
    if (currentPage > 1) url.searchParams.set('page', String(currentPage));
    else url.searchParams.delete('page');
    if (url.href !== window.location.href) {
      if (mode === 'push') history.pushState(null, '', url);
      else history.replaceState(null, '', url);
    }
  }

  function render(mode: 'push' | 'replace' = 'replace') {
    const query = input.value.trim().toLowerCase();
    const matches = query ? posts.filter((post) => post.fields.some((field) => field.includes(query))) : posts;
    const totalPages = Math.ceil(matches.length / POSTS_PER_PAGE);
    currentPage = Math.max(1, Math.min(currentPage, totalPages || 1));
    const start = (currentPage - 1) * POSTS_PER_PAGE;
    const pagePosts = matches.slice(start, start + POSTS_PER_PAGE);
    const visible = new Set(pagePosts.map((post) => post.article));
    articles.forEach((article) => { article.hidden = !visible.has(article); });
    pagePosts.forEach((post, index) => {
      post.article.querySelector('[data-entry-number]')!.textContent = String(start + index + 1).padStart(2, '0');
    });

    const yearCounts = new Map<string, number>();
    matches.forEach((post) => yearCounts.set(post.year, (yearCounts.get(post.year) || 0) + 1));
    const visibleYears = new Set(pagePosts.map((post) => post.year));
    yearGroups.forEach((group) => {
      group.hidden = !visibleYears.has(group.dataset.year!);
      group.querySelector('[data-year-count]')!.textContent = `${yearCounts.get(group.dataset.year!) || 0} 篇文章`;
    });

    count.textContent = query ? `找到 ${matches.length} 篇` : '';
    empty.hidden = matches.length > 0;
    updateLocation(mode);
    pagination.dispatchEvent(new CustomEvent('pagination:update', { detail: { current: currentPage, total: totalPages } }));
  }

  await customElements.whenDefined('blog-pagination');
  input.addEventListener('input', () => {
    currentPage = 1;
    render();
  });
  pagination.addEventListener('pagination:change', (event) => {
    const page = (event as CustomEvent<{ page: number }>).detail.page;
    if (page === currentPage) return;
    currentPage = page;
    render('push');
    list.scrollIntoView({ block: 'start' });
  });
  window.addEventListener('popstate', () => {
    readLocation();
    render();
  });
  readLocation();
  render();
  input.disabled = false;
  input.setAttribute('aria-busy', 'false');
</script>
