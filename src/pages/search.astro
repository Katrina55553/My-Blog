---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ViewCounter from '../components/ViewCounter.astro';

const posts = await getCollection('posts');
const sorted = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const grouped = new Map<number, typeof sorted>();
for (const post of sorted) {
  const year = post.data.date.getUTCFullYear();
  if (!grouped.has(year)) grouped.set(year, []);
  grouped.get(year)!.push(post);
}

const pad = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout title="Search" description="Search and browse all articles" wide="listing">
  <section>
    <header class="reveal mb-10">
      <p class="label-caps text-vermilion mb-4" data-i18n="search.kicker">§ The Archive</p>
      <h1 class="font-display font-semibold text-ink tracking-tight text-4xl md:text-5xl leading-[1.05] mb-3" data-i18n="search.title">
        Search
      </h1>
      <p class="font-newsreader text-lg text-ink-3 italic" data-i18n="search.subtitle">Filter the journal by title, tag, or keyword.</p>
    </header>

    <!-- Search -->
    <div class="relative mb-12">
      <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-ink-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input
        type="text"
        id="archive-search"
        placeholder="Search the journal…"
        data-i18n-placeholder="search.placeholder"
        class="w-full bg-paper-2/60 border border-rule hover:border-rule-2 rounded-none pl-11 pr-4 sm:pr-40 py-3 font-newsreader text-base text-ink placeholder-ink-4 italic
               focus:outline-none focus:border-vermilion focus:bg-paper-2 transition-colors"
        autocomplete="off"
        disabled
        aria-busy="true"
      />
      <span class="absolute right-4 top-1/2 -translate-y-1/2 label-caps text-ink-4 pointer-events-none hidden sm:block" id="result-count"></span>
    </div>

    <!-- Archive list -->
    <div id="archive-list" class="space-y-12">
      {[...grouped.entries()].map(([year, yearPosts]) => (
        <div data-year={year}>
          <div class="flex items-baseline gap-4 mb-5">
            <h2 class="font-display font-semibold text-ink text-3xl tracking-tight">{year}</h2>
            <span class="h-px flex-1 bg-rule"></span>
            <span class="label-caps text-ink-4" data-i18n="search.entries" data-i18n-params={JSON.stringify({ n: yearPosts.length })}>{yearPosts.length} {yearPosts.length === 1 ? 'entry' : 'entries'}</span>
          </div>
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-x-12 xl:gap-x-20 gap-y-10 lg:gap-y-12">
            {yearPosts.map((post, i) => {
              const { title, date, tags, description } = post.data;
              const formattedDate = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

              return (
                <article class="card-rule group reveal min-w-0 lg:border-b border-rule lg:pb-8" style={`animation-delay: ${Math.min(i, 5) * 90}ms`} data-slug={post.slug}>
                  <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2 mb-2">
                    <span class="font-display text-vermilion font-semibold text-sm w-7 shrink-0 tabular-nums">{pad(i + 1)}</span>
                    <time class="label-caps text-ink-4" data-i18n-date={date.toISOString().slice(0, 10)}>{formattedDate}</time>
                    <span class="text-rule-2">·</span>
                    <ViewCounter slug={post.slug} />
                  </div>
                  <h3 class="font-display font-semibold text-ink text-2xl md:text-3xl tracking-tight mb-2 pl-11">
                    <a
                      href={`/posts/${post.slug}/`}
                      class="no-underline bg-gradient-to-r from-vermilion to-vermilion bg-[length:0%_2px] bg-no-repeat bg-left-bottom transition-[background-size] duration-500 group-hover:bg-[length:100%_2px]"
                    >
                      {title}
                    </a>
                  </h3>
                  <p class="font-newsreader text-ink-2 leading-relaxed pl-11 mb-3">{description}</p>
                  <div class="flex flex-wrap gap-x-4 gap-y-1 pl-11">
                    {tags.map((tag: string) => (
                      <a href={`/tags/${tag}/`} class="font-mono text-xs text-ink-3 hover:text-vermilion transition-colors no-underline">
                        <span class="text-vermilion">#</span>{tag}
                      </a>
                    ))}
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  let posts: Array<{ title: string; slug: string; tags: string[]; description: string }> = [];

  function t(key: string, params?: Record<string, string | number>) {
    const i = (window as any).__I18N__;
    return i ? i.t(key, params) : key;
  }

  async function loadPosts() {
    try {
      const res = await fetch('/search.json');
      if (res.ok) posts = await res.json();
    } catch (_) {
      // The server-rendered archive remains usable when the search index fails.
    } finally {
      input.disabled = false;
      input.setAttribute('aria-busy', 'false');
      applyFilter();
    }
  }

  const input = document.getElementById('archive-search') as HTMLInputElement;
  const list = document.getElementById('archive-list')!;
  const count = document.getElementById('result-count')!;
  let lastCount = -1; // -1 = no active query

  function applyFilter() {
    const q = input.value.trim().toLowerCase();
    const articles = list.querySelectorAll<HTMLElement>('article[data-slug]');
    const yearGroups = list.querySelectorAll<HTMLElement>('[data-year]');

    if (!q) {
      articles.forEach((a) => (a.style.display = ''));
      yearGroups.forEach((g) => (g.style.display = ''));
      count.textContent = '';
      lastCount = -1;
      return;
    }

    const matchSet = new Set(
      posts
        .filter(
          (p) =>
            p.title.toLowerCase().includes(q) ||
            p.tags.some((t) => t.toLowerCase().includes(q)) ||
            p.description.toLowerCase().includes(q),
        )
        .map((p) => p.slug),
    );

    let visibleCount = 0;
    articles.forEach((a) => {
      const visible = matchSet.has(a.dataset.slug!);
      a.style.display = visible ? '' : 'none';
      if (visible) visibleCount++;
    });

    yearGroups.forEach((g) => {
      const visible = g.querySelectorAll<HTMLElement>('article[data-slug]');
      const hasVisible = Array.from(visible).some((a) => a.style.display !== 'none');
      g.style.display = hasVisible ? '' : 'none';
    });

    lastCount = visibleCount;
    count.textContent = t('search.found', { n: visibleCount });
  }

  input.addEventListener('input', applyFilter);

  document.addEventListener('langchange', () => {
    if (lastCount >= 0) count.textContent = t('search.found', { n: lastCount });
  });

  loadPosts();
</script>
