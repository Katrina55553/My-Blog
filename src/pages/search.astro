---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = await getCollection('posts');
const sorted = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const grouped = new Map<number, typeof sorted>();
for (const post of sorted) {
  const year = new Date(post.data.date).getFullYear();
  if (!grouped.has(year)) grouped.set(year, []);
  grouped.get(year)!.push(post);
}

interface PostItem {
  title: string;
  slug: string;
  tags: string[];
  description: string;
  date: string;
  year: number;
  monthDay: string;
}

const allPosts: PostItem[] = sorted.map((post) => {
  const d = new Date(post.data.date);
  return {
    title: post.data.title,
    slug: post.slug,
    tags: post.data.tags,
    description: post.data.description,
    date: d.toISOString(),
    year: d.getFullYear(),
    monthDay: d.toLocaleDateString('zh-CN', { month: 'long', day: 'numeric' }),
  };
});
---

<BaseLayout title="Search" description="Search and browse all articles">
  <section class="py-12">
    <h1 class="text-4xl font-bold text-white mb-8">Search</h1>

    <!-- Search -->
    <div class="relative mb-10">
      <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input
        type="text"
        id="archive-search"
        placeholder="Filter by title, tag, or keyword..."
        class="w-full bg-slate-900/80 border border-slate-700 hover:border-slate-600 rounded-xl pl-10 pr-4 py-2.5 text-sm text-slate-200 placeholder-slate-500
               focus:outline-none focus:border-cyan-500 focus:bg-slate-900 transition-all"
        autocomplete="off"
      />
    </div>

    <!-- Archive list -->
    <div id="archive-list" class="space-y-10">
      {[...grouped.entries()].map(([year, yearPosts]) => (
        <div data-year={year}>
          <h2 class="text-2xl font-bold text-slate-400 mb-4">{year}</h2>
          <div class="space-y-3">
            {yearPosts.map((post) => {
              const { title, description } = post.data;
              const d = new Date(post.data.date);
              const monthDay = d.toLocaleDateString('zh-CN', { month: 'long', day: 'numeric' });

              return (
                <article class="flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-6 border-b border-slate-800 pb-3" data-slug={post.slug}>
                  <time class="text-sm text-slate-500 shrink-0">{monthDay}</time>
                  <div>
                    <a
                      href={`/posts/${post.slug}`}
                      class="text-white hover:text-cyan-400 transition-colors no-underline font-medium"
                    >
                      {title}
                    </a>
                    <p class="text-sm text-slate-500 mt-1">{description}</p>
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  const posts: Array<{ title: string; slug: string; tags: string[]; description: string; date: string; year: number; monthDay: string }> = JSON.parse(`${
    JSON.stringify(allPosts)
  }`);

  const input = document.getElementById('archive-search') as HTMLInputElement;
  const list = document.getElementById('archive-list')!;

  input.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    const articles = list.querySelectorAll<HTMLElement>('article[data-slug]');
    const yearGroups = list.querySelectorAll<HTMLElement>('[data-year]');

    if (!q) {
      // Show all
      articles.forEach((a) => (a.style.display = ''));
      yearGroups.forEach((g) => (g.style.display = ''));
      return;
    }

    const matchSet = new Set(
      posts
        .filter(
          (p) =>
            p.title.toLowerCase().includes(q) ||
            p.tags.some((t) => t.toLowerCase().includes(q)) ||
            p.description.toLowerCase().includes(q),
        )
        .map((p) => p.slug),
    );

    articles.forEach((a) => {
      a.style.display = matchSet.has(a.dataset.slug!) ? '' : 'none';
    });

    yearGroups.forEach((g) => {
      const visible = g.querySelectorAll<HTMLElement>('article[data-slug]');
      const hasVisible = Array.from(visible).some((a) => a.style.display !== 'none');
      g.style.display = hasVisible ? '' : 'none';
    });
  });
</script>
