---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Pagination from '../../components/Pagination.astro';
import ViewCounter from '../../components/ViewCounter.astro';
import { POSTS_PER_PAGE } from '../../lib/pagination';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const perPage = POSTS_PER_PAGE;
  const totalPages = Math.ceil(posts.length / perPage);

  return Array.from({ length: totalPages - 1 }, (_, i) => ({
    params: { page: String(i + 2) },
  }));
}

const posts = await getCollection('posts');
const sorted = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const perPage = POSTS_PER_PAGE;
const totalPages = Math.ceil(sorted.length / perPage);
const currentPage = Number(Astro.params.page!);
const start = (currentPage - 1) * perPage;
const pagePosts = sorted.slice(start, start + perPage);

const pad = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout title={`第 ${currentPage} 页`} description={`Katrina 的博客，第 ${currentPage} 页`} wide="listing">
  <section>
    <header class="reveal mb-12">
      <h1 class="font-display font-semibold text-ink tracking-tight text-4xl md:text-5xl leading-[1.05]">
        第 <span class="italic text-vermilion">{currentPage}</span> 页
      </h1>
      <p class="font-newsreader text-lg text-ink-3 mt-3">
        第 {start + 1}–{Math.min(start + perPage, sorted.length)} 篇，共 {sorted.length} 篇
      </p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-x-12 xl:gap-x-20 gap-y-10 lg:gap-y-12">
      {pagePosts.map((post, i) => {
        const { title, date, tags, description } = post.data;
        const formattedDate = date.toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
          timeZone: 'UTC',
        });

        return (
          <article class="card-rule group reveal min-w-0 lg:border-b border-rule lg:pb-8" style={`animation-delay: ${i * 90}ms`}>
            <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2 mb-2">
              <span class="font-display text-vermilion font-semibold text-sm w-7 shrink-0 tabular-nums">{pad(start + i + 1)}</span>
              <time class="label-caps text-ink-4" datetime={date.toISOString().slice(0, 10)} lang="en">{formattedDate}</time>
              <span class="text-rule-2">·</span>
              <ViewCounter slug={post.slug} />
            </div>
            <h3 class="font-display font-semibold text-ink text-2xl md:text-3xl tracking-tight mb-2 pl-11">
              <a href={`/posts/${post.slug}/`} class="no-underline bg-gradient-to-r from-vermilion to-vermilion bg-[length:0%_2px] bg-no-repeat bg-left-bottom transition-[background-size] duration-500 group-hover:bg-[length:100%_2px]">
                {title}
              </a>
            </h3>
            <p class="font-newsreader text-ink-2 leading-relaxed pl-11 mb-3">{description}</p>
            <div class="flex flex-wrap gap-x-4 gap-y-1 pl-11">
              {tags.map((tag: string) => (
                <a href={`/tags/${tag}/`} class="font-mono text-xs text-ink-3 hover:text-vermilion transition-colors no-underline">
                  <span class="text-vermilion">#</span>{tag}
                </a>
              ))}
            </div>
          </article>
        );
      })}
    </div>

    <Pagination current={currentPage} total={totalPages} />
  </section>
</BaseLayout>
