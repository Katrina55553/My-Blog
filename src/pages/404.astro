---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在" description="您访问的页面不存在，或已被移除">
  <section class="reveal py-20 md:py-28 text-center">
    <p class="label-caps text-vermilion mb-6">§ 勘误</p>
    <h1 class="font-display font-semibold text-ink tracking-tight text-8xl md:text-9xl leading-none mb-2">
      4<span class="italic text-vermilion">0</span>4
    </h1>
    <p class="font-newsreader text-xl md:text-2xl text-ink-2 italic mb-2">
      这一页从手记中散佚了。
    </p>
    <p class="font-newsreader text-ink-3 mb-10">
      您访问的页面不存在，或已被移除。
    </p>
    <a
      href="/"
      class="group inline-flex items-center gap-3 border border-vermilion text-vermilion hover:bg-vermilion hover:text-paper px-6 py-2.5 no-underline transition-colors"
    >
      <span class="label-caps">返回首页</span>
      <span class="transition-transform group-hover:translate-x-1">→</span>
    </a>
  </section>
</BaseLayout>
