---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About" description="About Katrina">
  <section class="py-12 max-w-2xl">
    <h1 class="text-4xl font-bold text-white mb-6">About</h1>
    <div class="prose prose-invert prose-slate
      prose-p:text-slate-300 prose-p:leading-relaxed
      prose-a:text-cyan-400 prose-a:no-underline
    ">
      <p>
        Hi, I'm Katrina. I write about algorithms, programming, and things I learn along the way.
      </p>
      <p>
        This blog is built with <a href="https://astro.build">Astro</a> and <a href="https://tailwindcss.com">Tailwind CSS</a>,
        deployed on a cloud server with Docker.
      </p>
    </div>
  </section>
</BaseLayout>
