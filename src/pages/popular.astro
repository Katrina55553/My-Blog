---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = await getCollection('posts');
const postMap = Object.fromEntries(
  posts.map((p) => [p.slug, { title: p.data.title, date: p.data.date, tags: p.data.tags, description: p.data.description }]),
);
const websiteId = 'ceead9d3-35d9-4590-8678-d153328378a6';
---

<BaseLayout title="热门" description="Katrina 的博客中阅读量最高的文章" wide="listing">
  <section>
    <header class="reveal mb-12">
      <p class="label-caps text-vermilion mb-4">§ 最多阅读</p>
      <h1 class="font-display font-semibold text-ink tracking-tight text-4xl md:text-5xl leading-[1.05] mb-3 flex flex-wrap items-baseline gap-x-4">
        <span>热门</span>
        <span id="total-views" class="font-newsreader font-normal text-base text-ink-4 italic">&mdash;</span>
      </h1>
    </header>
    <div id="popular-list" class="grid grid-cols-1 lg:grid-cols-2 gap-x-12 xl:gap-x-20 gap-y-10 lg:gap-y-12">
      <p class="font-newsreader text-ink-3 italic lg:col-span-2">正在加载……</p>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ postMap, websiteId }}>
  (() => {
    const CACHE_KEY = '__vc_data';
    const TTL = 30 * 60 * 1000;
    const container = document.getElementById('popular-list');
    const posts = JSON.parse(JSON.stringify(postMap));

    function pad(n) { return String(n).padStart(2, '0'); }

    function render(data) {
      const list = Object.entries(posts)
        .map(([slug, meta]) => {
          const paths = [`/posts/${slug}`, `/posts/${slug}/`];
          const views = data
            .filter((item) => paths.includes(item.x) && typeof item.y === 'number')
            .reduce((sum, item) => sum + item.y, 0);
          return { slug, ...meta, views };
        })
        .sort((a, b) => b.views - a.views);

      const total = list.reduce((sum, p) => sum + p.views, 0);
      const tv = document.getElementById('total-views');
      if (tv) tv.textContent = total > 0 ? `— 共 ${total.toLocaleString('zh-CN')} 次阅读` : '';

      if (list.length === 0) {
        container.innerHTML = '<p class="font-newsreader text-ink-3 italic lg:col-span-2">还没有文章。</p>';
        return;
      }

      container.innerHTML = list
        .map((post, i) => {
          const date = new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
          const tags = post.tags?.map((t) => `<a href="/tags/${t}/" class="font-mono text-xs text-ink-3 hover:text-vermilion no-underline transition-colors"><span class="text-vermilion">#</span>${t}</a>`).join(' ') || '';
          const viewsText = post.views > 0 ? `${post.views.toLocaleString('zh-CN')} 次阅读` : '&mdash;';
          const isTop = i === 0;

          return `
            <article class="card-rule group reveal min-w-0 lg:border-b border-rule lg:pb-8" style="animation-delay: ${Math.min(i, 5) * 90}ms">
              <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2 mb-2">
                <span class="font-display ${isTop ? 'text-gold' : 'text-vermilion'} font-semibold text-sm w-7 shrink-0 tabular-nums">${pad(i + 1)}</span>
                <time class="label-caps text-ink-4" datetime="${String(post.date).slice(0, 10)}" lang="en">${date}</time>
                <span class="text-rule-2">·</span>
                <span class="label-caps text-ink-4 tabular-nums">${viewsText}</span>
              </div>
              <h3 class="font-display font-semibold text-ink text-2xl md:text-3xl tracking-tight mb-2 pl-11">
                <a href="/posts/${post.slug}/" class="no-underline bg-gradient-to-r from-vermilion to-vermilion bg-[length:0%_2px] bg-no-repeat bg-left-bottom transition-[background-size] duration-500 group-hover:bg-[length:100%_2px]">${post.title}</a>
              </h3>
              <p class="font-newsreader text-ink-2 leading-relaxed pl-11 mb-3">${post.description}</p>
              <div class="flex flex-wrap gap-x-4 gap-y-1 pl-11">${tags}</div>
            </article>`;
        })
        .join('');
    }

    function fetchAndCache() {
      const now = Date.now();
      return fetch(`/api/views/websites/${websiteId}/metrics?startAt=0&endAt=${now}&type=url`)
        .then((r) => { if (!r.ok) throw new Error('bad status'); return r.json(); })
        .then((data) => {
          try { localStorage.setItem(CACHE_KEY, JSON.stringify({ data, ts: now })); } catch (e) { /* quota */ }
          return data;
        });
    }

    function loadCache() {
      try {
        const raw = localStorage.getItem(CACHE_KEY);
        if (!raw) return null;
        const cached = JSON.parse(raw);
        if (cached.data && cached.ts && (Date.now() - cached.ts) < TTL) return cached.data;
      } catch (e) { /* ignore */ }
      return null;
    }

    const cached = loadCache();
    if (cached) { render(cached); return; }

    fetchAndCache()
      .then((data) => render(data))
      .catch(() => { container.innerHTML = '<p class="font-newsreader text-ink-3 italic lg:col-span-2">加载失败。</p>'; });
  })();
</script>
