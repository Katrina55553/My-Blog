---
export interface TocHeading {
  depth: number;
  text: string;
  slug: string;
}

interface Props {
  headings: TocHeading[];
  articleSlug?: string;
}

const { headings, articleSlug } = Astro.props;
const hasToc = headings.length > 0;
const storageKey = articleSlug ? `toc-collapsed-${articleSlug}` : 'toc-collapsed';
---

{hasToc && (
  <aside
    id="toc-sidebar"
    class="hidden xl:block w-64 shrink-0"
  >
    <div class="sticky top-20">
      <div class="flex items-center justify-between mb-3">
        <span class="text-sm font-semibold text-slate-300 uppercase tracking-wider">目录</span>
        <button
          id="toc-toggle-btn"
          class="text-slate-500 hover:text-slate-300 transition-colors p-0.5 leading-none cursor-pointer"
          aria-label="折叠目录"
        >
          <svg id="toc-chevron" class="w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 6L15 12L9 18" />
          </svg>
        </button>
      </div>
      <nav id="toc-content" class="relative">
        <div class="absolute left-0 top-0 bottom-0 w-px bg-slate-800"></div>
        <ul class="space-y-1">
          {headings.map((h) => (
            <li>
              <a
                href={`#${h.slug}`}
                class="toc-link block text-base leading-relaxed py-1 border-l-2 -ml-px border-transparent text-slate-400 hover:text-slate-200 hover:border-slate-600 transition-colors no-underline"
                style={`padding-left: ${(h.depth - 2) * 0.75 + 0.75}rem`}
              >
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </aside>
)}

<script define:vars={{ storageKey }}>
  (function initToc() {
    const sidebar = document.getElementById('toc-sidebar');
    const toggleBtn = document.getElementById('toc-toggle-btn');
    const content = document.getElementById('toc-content');
    const chevron = document.getElementById('toc-chevron');

    if (!sidebar || !toggleBtn || !content || !chevron) return;

    function collapse() {
      content.classList.add('hidden');
      chevron.style.transform = 'rotate(180deg)';
      try { localStorage.setItem(storageKey, 'true'); } catch (_) { /* noop */ }
    }

    function expand() {
      content.classList.remove('hidden');
      chevron.style.transform = 'rotate(0deg)';
      try { localStorage.removeItem(storageKey); } catch (_) { /* noop */ }
    }

    function toggle() {
      if (content.classList.contains('hidden')) {
        expand();
      } else {
        collapse();
      }
    }

    toggleBtn.addEventListener('click', toggle);

    try {
      if (localStorage.getItem(storageKey) === 'true') {
        collapse();
      }
    } catch (_) { /* noop */ }

    // ===== 滚动监听高亮 =====
    const headings = [...document.querySelectorAll('h2[id], h3[id]')];
    const links = document.querySelectorAll('.toc-link');

    if (headings.length === 0 || links.length === 0) return;

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);

        if (visible.length > 0) {
          const id = visible[0].target.id;
          links.forEach((l) => {
            if (l.getAttribute('href') === `#${id}`) {
              l.classList.add('toc-active');
            } else {
              l.classList.remove('toc-active');
            }
          });
        }
      },
      { rootMargin: '-100px 0px 0px 0px' }
    );

    headings.forEach((h) => observer.observe(h));
  })();
</script>

<style is:global>
  .toc-active {
    color: #22d3ee !important;
    border-color: #22d3ee !important;
  }
</style>
