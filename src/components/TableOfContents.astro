---
export interface TocHeading {
  depth: number;
  text: string;
  slug: string;
}

interface Props {
  headings: TocHeading[];
  articleSlug?: string;
}

const { headings, articleSlug } = Astro.props;
const hasToc = headings.length > 0;
const storageKey = articleSlug ? `toc-collapsed-${articleSlug}` : 'toc-collapsed';
---

{hasToc && (
  <>
    <!-- 切换按钮 — 夹在正文和目录之间 -->
    <button
      id="toc-toggle-btn"
      class="hidden xl:flex shrink-0 sticky top-20 w-7 h-10 items-center justify-center bg-paper-2/60 hover:bg-paper-3 border border-rule rounded-sm text-ink-4 hover:text-vermilion transition-colors cursor-pointer group"
      aria-label="切换目录"
    >
      <svg id="toc-chevron" class="w-3.5 h-3.5 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M9 6L15 12L9 18" />
      </svg>
    </button>

    <aside
      id="toc-sidebar"
      class="hidden xl:block w-64 shrink-0"
    >
      <div class="toc-scroll sticky top-20 max-h-[calc(100vh-5rem)] overflow-y-auto">
        <h3 class="label-caps text-ink-2 mb-4 flex items-center gap-2">
          <span class="text-vermilion">§</span> Contents
        </h3>
        <nav class="relative">
          <div class="absolute left-0 top-0 bottom-0 w-px bg-rule"></div>
          <ul class="space-y-1">
            {headings.map((h) => (
              <li>
                <a
                  href={`#${h.slug}`}
                  class="toc-link block font-newsreader text-base leading-relaxed py-1.5 border-l-2 -ml-px border-transparent text-ink-3 hover:text-ink hover:border-rule-2 transition-colors no-underline"
                  style={`padding-left: ${(h.depth - 2) * 0.75 + 0.75}rem`}
                >
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </aside>
  </>
)}

<script define:vars={{ storageKey }}>
  (function initToc() {
    const sidebar = document.getElementById('toc-sidebar');
    const toggleBtn = document.getElementById('toc-toggle-btn');
    const chevron = document.getElementById('toc-chevron');

    if (!sidebar || !toggleBtn || !chevron) return;

    function collapse() {
      sidebar.classList.add('!hidden');
      chevron.style.transform = 'rotate(180deg)';
      try { localStorage.setItem(storageKey, 'true'); } catch (_) { /* noop */ }
    }

    function expand() {
      sidebar.classList.remove('!hidden');
      chevron.style.transform = 'rotate(0deg)';
      try { localStorage.removeItem(storageKey); } catch (_) { /* noop */ }
    }

    toggleBtn.addEventListener('click', () => {
      if (sidebar.classList.contains('!hidden')) {
        expand();
      } else {
        collapse();
      }
    });

    try {
      if (localStorage.getItem(storageKey) === 'true') {
        collapse();
      }
    } catch (_) { /* noop */ }

    // ===== 滚动监听高亮 =====
    const headings = [...document.querySelectorAll('h2[id], h3[id]')];
    const links = document.querySelectorAll('.toc-link');

    if (headings.length === 0 || links.length === 0) return;

    const THRESHOLD = 100;

    function findActiveHeading() {
      // 在所有标题中查找当前处于视口内的标题
      const visible = headings
        .filter((h) => {
          const rect = h.getBoundingClientRect();
          return rect.top < window.innerHeight && rect.bottom > THRESHOLD;
        })
        .sort((a, b) => a.getBoundingClientRect().top - b.getBoundingClientRect().top);

      if (visible.length > 0) {
        return visible[0].id;
      }

      // 没有标题在视口内：反向查找最后一个已滚过 threshold 的标题
      for (let i = headings.length - 1; i >= 0; i--) {
        if (headings[i].getBoundingClientRect().top <= THRESHOLD) {
          return headings[i].id;
        }
      }
      return headings[0] ? headings[0].id : null;
    }

    function highlightLink(id) {
      if (!id) return;
      links.forEach((l) => {
        if (l.getAttribute('href') === `#${id}`) {
          l.classList.add('toc-active');
          l.scrollIntoView({ block: 'nearest' });
        } else {
          l.classList.remove('toc-active');
        }
      });
    }

    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          highlightLink(findActiveHeading());
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });

    // 页面加载时设置初始高亮
    highlightLink(findActiveHeading());
  })();
</script>

<style is:global>
  .toc-active {
    color: #b8412c !important;
    border-color: #b8412c !important;
    font-weight: 500;
  }
  .toc-scroll {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .toc-scroll::-webkit-scrollbar {
    display: none;
  }
</style>
