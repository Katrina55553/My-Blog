<div id="search" class="max-w-2xl mx-auto px-4 pt-12 pb-4">
  <div class="relative">
    <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
    <input
      type="text"
      id="search-input"
      placeholder="Search by title, tag, or keyword..."
      class="w-full bg-slate-900/80 border border-slate-700 hover:border-slate-600 rounded-xl pl-10 pr-4 py-2.5 text-sm text-slate-200 placeholder-slate-500
             focus:outline-none focus:border-cyan-500 focus:bg-slate-900 transition-all"
      autocomplete="off"
    />
    <div id="search-results" class="hidden absolute top-full left-0 right-0 mt-2 bg-slate-900 border border-slate-700 rounded-xl shadow-2xl z-20 max-h-80 overflow-y-auto">
    </div>
  </div>
</div>

<script>
  let posts: { title: string; slug: string; tags: string[]; description: string }[] = [];
  let loaded = false;

  async function loadPosts() {
    if (loaded) return;
    try {
      const res = await fetch('/search.json');
      if (res.ok) posts = await res.json();
    } catch (_) {}
    loaded = true;
  }

  const input = document.getElementById('search-input') as HTMLInputElement;
  const results = document.getElementById('search-results')!;

  input.addEventListener('focus', loadPosts);
  input.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    if (!q) {
      results.innerHTML = '';
      results.classList.add('hidden');
      return;
    }
    const filtered = posts.filter(
      (p) =>
        p.title.toLowerCase().includes(q) ||
        p.tags.some((t) => t.toLowerCase().includes(q)) ||
        p.description.toLowerCase().includes(q),
    );
    if (filtered.length === 0) {
      results.innerHTML = '<div class="px-4 py-3 text-sm text-slate-500">No results</div>';
    } else {
      results.innerHTML = filtered
        .slice(0, 8)
        .map(
          (p) => `
          <a href="/posts/${p.slug}" class="block px-4 py-3 hover:bg-slate-800 transition-colors no-underline border-b border-slate-800 last:border-0">
            <div class="text-sm text-white font-medium">${p.title}</div>
            <div class="text-xs text-slate-500 mt-1">${p.tags.map((t) => '#' + t).join(' ')}</div>
          </a>
        `,
        )
        .join('');
    }
    results.classList.remove('hidden');
  });

  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('#search')) {
      results.classList.add('hidden');
    }
  });
</script>
