---
const { slug } = Astro.props;
const websiteId = '6c99da40-95d4-4832-8aeb-ba2c2e508a7d';
---

<span id={`vc-${slug}`} class="text-sm text-slate-500">
  &mdash;
</span>
<script define:vars={{ slug, websiteId }}>
  (() => {
    const el = document.getElementById(`vc-${slug}`);
    if (!el) return;
    const pageUrl = `/posts/${slug}`;
    const now = Date.now();
    fetch(`/api/views/websites/${websiteId}/metrics?startAt=0&endAt=${now}&type=url`)
      .then((r) => { if (!r.ok) throw new Error('bad status'); return r.json(); })
      .then((data) => {
        const entry = data.find((item) => item.x === pageUrl);
        if (!entry || typeof entry.y !== 'number' || entry.y <= 0) { el.remove(); return; }
        el.textContent = entry.y === 1 ? '1 view' : `${entry.y} views`;
      })
      .catch(() => { el.remove(); });
  })();
</script>
