---
const { slug } = Astro.props;
const websiteId = '6c99da40-95d4-4832-8aeb-ba2c2e508a7d';
---

<span id="view-counter" class="text-sm text-slate-500" data-slug={slug} data-website-id={websiteId}>
  &mdash;
</span>
<script>
  (() => {
    const el = document.getElementById('view-counter');
    if (!el) return;
    const { slug: s, websiteId: wid } = el.dataset;
    const pageUrl = `/posts/${s}`;
    const now = Date.now();
    const apiUrl = `/api/views/websites/${wid}/metrics?startAt=0&endAt=${now}&type=url`;
    fetch(apiUrl)
      .then((r) => { if (!r.ok) throw new Error('bad status'); return r.json(); })
      .then((data) => {
        const entry = data.find((item) => item.x === pageUrl);
        if (!entry || typeof entry.y !== 'number' || entry.y <= 0) { el.remove(); return; }
        el.textContent = entry.y === 1 ? '1 view' : `${entry.y} views`;
      })
      .catch(() => { el.remove(); });
  })();
</script>
