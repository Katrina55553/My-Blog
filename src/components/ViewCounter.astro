---
const { slug } = Astro.props;
const websiteId = '6c99da40-95d4-4832-8aeb-ba2c2e508a7d';
---

<span id="view-counter" class="text-sm text-slate-500" data-slug={slug} data-website-id={websiteId}>
  &mdash;
</span>
<script>
  (() => {
    const el = document.getElementById('view-counter');
    if (!el) return;
    const { slug: s, websiteId: wid } = el.dataset;
    const pageUrl = `/posts/${s}`;
    const now = Date.now();
    const apiUrl = `/api/views/websites/${wid}/stats?startAt=0&endAt=${now}&url=${encodeURIComponent(pageUrl)}`;
    fetch(apiUrl)
      .then((r) => { if (!r.ok) throw new Error('bad status'); return r.json(); })
      .then((d) => {
        const count = d.pageviews;
        if (typeof count !== 'number' || count <= 0) { el.remove(); return; }
        el.textContent = count === 1 ? '1 view' : `${count} views`;
      })
      .catch(() => { el.remove(); });
  })();
</script>
