<button
  id="theme-toggle"
  class="text-slate-300 hover:text-cyan-400 transition-colors p-1"
  aria-label="Toggle theme"
>
  <svg id="sun-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
  </svg>
  <svg id="moon-icon" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
  </svg>
</button>

<script>
  const btn = document.getElementById('theme-toggle')!;
  const sun = document.getElementById('sun-icon')!;
  const moon = document.getElementById('moon-icon')!;
  const html = document.documentElement;

  function setTheme(light: boolean) {
    html.classList.toggle('light', light);
    sun.classList.toggle('hidden', light);
    moon.classList.toggle('hidden', !light);
    localStorage.setItem('theme', light ? 'light' : 'dark');
  }

  const saved = localStorage.getItem('theme');
  const isLight = saved === 'light';
  setTheme(isLight);

  btn.addEventListener('click', () => {
    setTheme(!html.classList.contains('light'));
  });
</script>
