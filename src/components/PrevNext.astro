---
import type { CollectionEntry } from 'astro:content';

interface Props {
  prev: CollectionEntry<'posts'> | null;
  next: CollectionEntry<'posts'> | null;
}

const { prev, next } = Astro.props;
---

<nav class="mt-16 pt-8 border-t border-rule grid grid-cols-2 gap-6">
  {prev ? (
    <a href={`/posts/${prev.slug}`} class="text-left no-underline group block">
      <span class="label-caps text-ink-4 block mb-2 flex items-center gap-1.5">
        <span class="text-vermilion transition-transform group-hover:-translate-x-1">←</span> Previous
      </span>
      <span class="font-display font-semibold text-ink text-lg leading-snug group-hover:text-vermilion transition-colors">{prev.data.title}</span>
    </a>
  ) : (
    <div />
  )}
  {next ? (
    <a href={`/posts/${next.slug}`} class="text-right no-underline group block">
      <span class="label-caps text-ink-4 block mb-2 flex items-center justify-end gap-1.5">
        Next <span class="text-vermilion transition-transform group-hover:translate-x-1">→</span>
      </span>
      <span class="font-display font-semibold text-ink text-lg leading-snug group-hover:text-vermilion transition-colors">{next.data.title}</span>
    </a>
  ) : (
    <div />
  )}
</nav>
