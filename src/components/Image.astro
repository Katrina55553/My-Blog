---
import { Image as AstroImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
}

const { src, alt, class: className } = Astro.props;
---

<AstroImage
  {src}
  {alt}
  class={className}
  loading="lazy"
  decoding="async"
/>
